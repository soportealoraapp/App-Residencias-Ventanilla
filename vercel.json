{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "curl --silent --show-error --fail --location --output composer-setup.php https://getcomposer.org/installer && php composer-setup.php --quiet && rm -f composer-setup.php && php composer.phar install --no-dev --optimize-autoloader --no-interaction --prefer-dist && rm -f composer.phar",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/public/assets/$1" },
    { "source": "/(css|js|img|favicon\\.ico|robots\\.txt)", "destination": "/public/$1" },
    { "source": "/(.*)", "destination": "/api/index.php" }
  ],
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Powered-By", "value": "" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "env": {
    "CI_ENVIRONMENT": "production",
    "COMPOSER_PROCESS_TIMEOUT": "600",
    "COMPOSER_ALLOW_SUPERUSER": "1"
  }
}
