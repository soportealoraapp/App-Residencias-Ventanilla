#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP (formato Vercel: solo letras, digitos y underscores)
# Tambien se soporta el formato con puntos para entornos locales
#--------------------------------------------------------------------
APP_BASEURL = https://app-residencias.vercel.app/
APP_FORCE_HTTPS = true
APP_ALLOWED_HOSTNAMES = app-residencias.vercel.app
APP_INDEX_PAGE =
APP_TIMEZONE = America/Mexico_City
APP_LOCALE = es

# Formato legacy con puntos (para spark serve local)
app.baseURL = https://app-residencias.vercel.app/
app.indexPage =
app.forceGlobalSecureRequests = true

#--------------------------------------------------------------------
# DATABASE - SUPABASE POSTGRESQL
#
# NOTA: En Vercel solo se aceptan nombres SIN puntos (letras, digitos, _)
# Se usan variables estandar POSTGRES_* de Supabase + DATABASE_DEFAULT_*
# + formato legacy database.default.*
#--------------------------------------------------------------------

# ============================================================
# Conexion principal (non-pooling, puerto 5432)
# ============================================================
POSTGRES_HOST = db.xxxxx.supabase.co
POSTGRES_PORT = 5432
POSTGRES_USER = postgres
POSTGRES_PASSWORD = REDACTED
POSTGRES_DATABASE = postgres

# URL completa non-pooling (para referencia)
POSTGRES_URL_NON_POOLING = postgres://postgres.xxxxx:REDACTED@db.xxxxx.supabase.co:5432/postgres?sslmode=require

# ============================================================
# Connection pooler (puerto 6543, PgBouncer)
# ============================================================
POSTGRES_PRISMA_URL = postgres://postgres.xxxxx:REDACTED@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
POSTGRES_URL = postgres://postgres.xxxxx:REDACTED@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# ============================================================
# Alias DATABASE_DEFAULT_* (formato Vercel compatible)
# ============================================================
DATABASE_DEFAULT_DBDRIVER = Postgre
DATABASE_DEFAULT_HOSTNAME = db.xxxxx.supabase.co
DATABASE_DEFAULT_DATABASE = postgres
DATABASE_DEFAULT_USERNAME = postgres
DATABASE_DEFAULT_PASSWORD = REDACTED
DATABASE_DEFAULT_DBPREFIX =
DATABASE_DEFAULT_PORT = 5432
DATABASE_DEFAULT_CHARSET = utf8
DATABASE_DEFAULT_SCHEMA = public
DATABASE_DEFAULT_SSLMODE = require
DATABASE_DEFAULT_FOREIGNKEYS = true

# ============================================================
# Formato legacy database.default.* (para spark local)
# ============================================================
database.default.DBDriver = Postgre
database.default.hostname = db.xxxxx.supabase.co
database.default.database = postgres
database.default.username = postgres
database.default.password = REDACTED
database.default.DBPrefix =
database.default.port     = 5432
database.default.charset  = utf8
database.default.schema   = public
database.default.sslmode  = require
database.default.foreignKeys = true

#--------------------------------------------------------------------
# SUPABASE PROJECT (API y Storage)
#--------------------------------------------------------------------
SUPABASE_URL = https://xxxxx.supabase.co
SUPABASE_ANON_KEY = REDACTED
SUPABASE_PUBLISHABLE_KEY = REDACTED
SUPABASE_JWT_SECRET = REDACTED
SUPABASE_SECRET_KEY = REDACTED
SUPABASE_SERVICE_ROLE_KEY = REDACTED

# Alias estilo Next.js (por si se reutilizan)
NEXT_PUBLIC_SUPABASE_URL = https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY = REDACTED

#--------------------------------------------------------------------
# SECURITY - CSRF / Cookies (produccion HTTPS)
#--------------------------------------------------------------------
SECURITY_CSRFPROTECTION = true
SECURITY_CSRFTOKENNAME = csrf_csrf_token
SECURITY_CSRFCOOKIENAME = csrf_cookie
SECURITY_CSRFEXPIRE = 7200
SECURITY_CSRFREGENERATE = true
SECURITY_CSRFEXCLUDEURIS =
SECURITY_CSRFSAMESITE = Lax

security.CSRFProtection  = true
security.CSRFTokenName   = csrf_csrf_token
security.CSRFCookieName  = csrf_cookie
security.CSRFExpire      = 7200
security.CSRFRegenerate  = true
security.CSRFExcludeURIs =
security.CSRFSameSite    = Lax

#--------------------------------------------------------------------
# COOKIES
#--------------------------------------------------------------------
COOKIE_PREFIX =
COOKIE_EXPIRES = 0
COOKIE_PATH = /
COOKIE_DOMAIN = .app-residencias.vercel.app
COOKIE_SECURE = true
COOKIE_HTTPONLY = true
COOKIE_SAMESITE = Lax
COOKIE_RAW = false

cookie.prefix     =
cookie.expires    = 0
cookie.path       = /
cookie.domain     = .app-residencias.vercel.app
cookie.secure     = true
cookie.httponly   = true
cookie.samesite   = Lax
cookie.raw        = false

#--------------------------------------------------------------------
# CUSTOM - Feature flags del proyecto
#--------------------------------------------------------------------
APP_ENABLE_UR_TT_T_06 = false

#--------------------------------------------------------------------
# EMAIL - GMAIL SMTP
#--------------------------------------------------------------------
EMAIL_SMTP_HOST = smtp.gmail.com
EMAIL_SMTP_PORT = 565
EMAIL_SMTP_USER = tu-correo@gmail.com
EMAIL_SMTP_PASS = tu-contraseña-de-aplicacion
EMAIL_FROM = tu-correo@gmail.com
EMAIL_FROM_NAME = Ventanilla Digital Uriangato
