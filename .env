#--------------------------------------------------------------------
# SECURITY - CSRF / Cookies (produccion HTTPS)
#--------------------------------------------------------------------
SECURITY_CSRFPROTECTION = true
SECURITY_CSRFTOKENNAME = csrf_csrf_token
SECURITY_CSRFCOOKIENAME = csrf_cookie
SECURITY_CSRFEXPIRE = 7200
SECURITY_CSRFREGENERATE = true
SECURITY_CSRFEXCLUDEURIS =
SECURITY_CSRFSAMESITE = Lax

security.CSRFProtection  = true
security.CSRFTokenName   = csrf_csrf_token
security.CSRFCookieName  = csrf_cookie
security.CSRFExpire      = 7200
security.CSRFRegenerate  = true
security.CSRFExcludeURIs =
security.CSRFSameSite    = Lax

